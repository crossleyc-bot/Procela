# Procela environment variables.
#
# Local dev: copy to .env, fill in any AI / Anthropic keys you want;
# the others can stay blank and the app will fall back to safe dev
# defaults (in-memory rate limiter, audit-log password resets, etc).
#
# Production: every var marked PROD-REQUIRED below MUST be set or
# the startup readiness check will warn in the log and a feature
# will silently degrade.

# ── Core ──
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
APP_URL=http://localhost:5173                # PROD-REQUIRED — used in reset-email links

# ── Database ──
# Setting DATABASE_URL puts the app in Postgres mode. That path requires a
# running Postgres AND a one-time setup, or the backend fails to boot with
# "Cannot read properties of undefined (reading 'findUnique')":
#   docker compose up -d postgres        # (or your own Postgres at this URL)
#   npm run db:generate -w packages/backend   # generate the Prisma client
#   npm run db:migrate  -w packages/backend   # apply the schema
# To run with ZERO dependencies instead, comment DATABASE_URL out: the backend
# falls back to JSON-file persistence (a .procela-data/ dir) — no Postgres, no
# generate/migrate needed. This is the simplest way to run `npm run dev` locally.
#
# Host is 127.0.0.1 (not "localhost") on purpose: on Windows "localhost"
# resolves to IPv6 (::1) first, where Docker Desktop's 5432 port-forward may
# not answer even though the container is healthy — the backend then fails
# with "Can't reach database server at localhost:5432". 127.0.0.1 forces IPv4
# and works on every platform.
DATABASE_URL=postgresql://procela:procela@127.0.0.1:5432/procela

# ── Direct-connect SSRF guard ──
# The direct-connect discovery/sync path opens a socket to a user-configured
# database host. The cloud metadata / link-local range (169.254.0.0/16, IPv6
# fe80::/10, fd00:ec2::254) is ALWAYS refused — no real database lives there.
# Set this to 1/true to ADDITIONALLY refuse loopback and RFC-1918 private
# ranges: appropriate for a hardened cloud deployment that never connects to
# an internal database. Leave unset for dev / on-prem, where connecting to a
# database on a private or loopback address is normal.
DB_SOURCE_BLOCK_PRIVATE_HOSTS=

# ── Auth provider ──
# dev | local | oidc | saml
AUTH_PROVIDER=dev
JWT_SECRET=change-me-in-production            # PROD-REQUIRED — sessions are forgeable with the default
# Token signing algorithm. Unset (default) = auto: RS256 when the PEM
# pair below is present, otherwise HS256 using JWT_SECRET. Set RS256 to
# require asymmetric signing (fails fast if the PEMs are missing), or
# HS256 to force symmetric even when PEMs are present (rolling rotation).
JWT_ALGORITHM=
# RSA PEM pair for RS256. When both are set, access tokens sign with
# RS256 and the public JWKS is served at /api/v1/auth/jwks.json so
# downstream services can verify without the shared secret.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Key id written into the JWT header and the JWKS. Default: procela-1.
JWT_KID=

# OIDC (Cognito / Microsoft / Okta)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Plaintext or an enc:v1:… envelope encrypted with MFA_ENCRYPTION_KEY.
# POST /auth/encrypt-secret { plaintext } returns the envelope to paste
# in here so the secret isn't sitting on disk in cleartext.
OIDC_CLIENT_SECRET=

# SAML 2.0 (SP-initiated SSO via @node-saml/node-saml)
# All four required when AUTH_PROVIDER=saml. IdP-side configuration
# uses the SP metadata served at GET /api/v1/auth/saml/metadata.
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_IDP_CERT=
SAML_CALLBACK_URL=
# Optional — IdP's Single Logout endpoint. When set, /auth/logout
# emits an SP-initiated SLO redirect to invalidate the IdP session
# as well as the Procela session.
SAML_LOGOUT_URL=

# ── Local-credential policy ──
# Optional. Point at a custom HIBP-derived wordlist (one password per
# line, # comments allowed). Falls back to the bundled file when unset.
BREACHED_PASSWORDS_FILE=

# ── SCIM 2.0 provisioning ──
# Optional. Static bearer token that IdPs (Microsoft Entra, Okta)
# present when pushing user lifecycle events to /scim/v2/. Generate
# a long random string and paste the same value into both Procela's
# env and the IdP's SCIM provisioning config. When unset, every SCIM
# request returns 401.
SCIM_BEARER_TOKEN=

# ── First-run bootstrap (day-zero tenant) ──
# A clean production database has zero orgs and zero users — but creating a
# top-level org requires a SUPER_ADMIN, so without this you'd have to hand-
# insert one in Postgres. Set BOOTSTRAP_SUPER_ADMIN_EMAIL and the backend, on
# every boot (idempotently), ensures the primary org exists and that this email
# is a SUPER_ADMIN in it. On first SSO login that email resolves as SUPER_ADMIN.
# All no-ops unless BOOTSTRAP_SUPER_ADMIN_EMAIL is set.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_NAME=
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_INDUSTRY=

# ── SSO provisioning (where federated users land) ──
# When an OIDC/SCIM user first appears, which tenant + role do they get?
# By default: the primary org (the bootstrap org) + VIEWER.
#   SSO_DEFAULT_ORG_ID  override the default org id (advanced; must match the
#                       API's default tenant if you rely on unscoped defaults).
#   SSO_DEFAULT_ROLE    role when the IdP emits no known role claim (default VIEWER).
#   SSO_DOMAIN_ORG_MAP  optional JSON routing email domains to orgs (+ optional
#                       role), for multi-tenant deployments, e.g.
#                       {"acme.com":"<orgId>","beta.io":{"orgId":"<orgId>","role":"CONTRIBUTOR"}}
# A real IdP role claim (group → EDITOR/ORG_ADMIN/…) still wins over the default.
SSO_DEFAULT_ORG_ID=
SSO_DEFAULT_ROLE=
SSO_DOMAIN_ORG_MAP=

# ── At-rest encryption for TOTP / MFA secrets ──
# PROD-REQUIRED. The TOTP secret (HMAC key) has to be recoverable on
# every login so it can't be hashed; instead it's encrypted with
# AES-256-GCM. The key here is the master encryption key — the
# actual encryption key is derived via scrypt with a fixed salt.
# Generate a 32+ char random value; rotate by re-encrypting every
# record with a new key (out of scope for this prototype). When
# unset, secrets are stored in plaintext (dev only — production
# refuses to start with a warning).
MFA_ENCRYPTION_KEY=

# Cloud KMS providers (alternative to MFA_ENCRYPTION_KEY). Pick one:
#   KMS_PROVIDER=aws-kms     uses AWS KMS via @aws-sdk/client-kms
#   KMS_PROVIDER=azure-kv    uses Azure Key Vault via @azure/keyvault-keys
#                            + @azure/identity (RSA-OAEP-256)
#   KMS_PROVIDER=gcp-kms     uses GCP KMS via @google-cloud/kms
# The SDK is lazy-imported on first use — install only the one you pick.
KMS_PROVIDER=

# AWS KMS — required when KMS_PROVIDER=aws-kms
AWS_KMS_KEY_ID=
AWS_KMS_REGION=
# Standard AWS SDK region. Used as the fallback for AWS_KMS_REGION and
# picked up by the SDK credential/region chain — usually already set in
# an AWS deployment.
AWS_REGION=
# AWS credentials picked up via standard SDK chain (env, profile, instance role).

# Azure Key Vault — required when KMS_PROVIDER=azure-kv
AZURE_KEYVAULT_URL=
AZURE_KEYVAULT_KEY_NAME=
# Azure credentials picked up via DefaultAzureCredential (env, managed
# identity, az login). The key must be an asymmetric (RSA / EC) key.

# GCP KMS — required when KMS_PROVIDER=gcp-kms
GCP_KMS_KEY_RESOURCE=
# GOOGLE_APPLICATION_CREDENTIALS env var points to the service-account
# JSON; on GKE / Cloud Run the workload identity is picked up automatically.

# ── AI ──
# Master switch for every AI integration feature: industry-template
# generation, data-domain + asset suggestions, the sensitivity classifier,
# the AI assistant, and governance AI agents. Defaults ON. Set to false to
# turn them off entirely — the backend refuses the AI endpoints and the
# frontend hides their UI. The single knob for deployments (on-prem /
# FedRAMP) that must not call an external model.
AI_FEATURES_ENABLED=
ANTHROPIC_API_KEY=
# Override the Claude model used for server-side AI calls (process
# template generation, data-domain suggestions, asset suggestions,
# chat). Defaults to the current Sonnet release. Set this to bump
# to a newer model without redeploying.
ANTHROPIC_MODEL=
# Per-org AI call quotas. AI_COST_CONTROLS_ENABLED takes 1/true or
# 0/false; unset defaults to ON in production, OFF in dev/test. When on,
# each org is capped at AI_MAX_CALLS_PER_ORG_PER_HOUR and _PER_DAY
# server-side AI calls. Defaults: 60/hour, 500/day.
AI_COST_CONTROLS_ENABLED=
AI_MAX_CALLS_PER_ORG_PER_HOUR=60
AI_MAX_CALLS_PER_ORG_PER_DAY=500
# Startup AI probe: a failed probe is normally logged loudly without
# crashing the app. Set to 1 to promote it to a hard exit (for a
# health-check-gated deploy), or 0 to disable. Default: on in production
# when ANTHROPIC_API_KEY is set, off otherwise.
FAIL_FAST_ON_AI_PROBE=

# ── Storage ──
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
STORAGE_LOCAL_PATH=./storage
# Directory for the JSON-file persistence store. Defaults to `.procela-data`
# under the process working directory when unset. Overridden mainly by tests
# that persist real rows and need a private directory so their disk writes
# don't collide with other parallel test files.
PROCELA_DATA_DIR=

# ── Redis (rate limiter coordination) ──
# PROD-REQUIRED. When unset, the rate limiter degrades to per-instance
# in-memory counters and multi-instance brute-force protection is broken.
REDIS_URL=
# How long to wait for the initial Redis connection before falling back
# to the in-memory limiter. Default: 2000 (2s).
REDIS_CONNECT_TIMEOUT_MS=2000

# ── API rate limiting (coarse per-IP backstop) ──
# A blanket per-IP limit across /api/v1, on top of the stricter per-route
# limits on login / password reset / support. Redis-backed when REDIS_URL
# is set, otherwise per-instance in-memory. Defaults: 600 requests per
# 60s window per IP.
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MS=60000

# ── Background schedulers (multi-replica coordination) ──
# The API runs in-process background loops: overdue-task sweep, weekly
# digest, agent-schedule ticker, connector offline scan, and token/session
# sweeps. They are NOT leader-aware — every replica runs its own copy — so
# if you run more than one API replica, designate ONE as the scheduler
# leader and set this on all the others. Leaving it unset everywhere while
# running multiple replicas causes duplicated AI spend and duplicate
# notifications. Unset (default) = this replica runs the schedulers.
#   PROCELA_DISABLE_SCHEDULERS=1   # non-leader replicas
# (PROCELA_DISABLE_SCHEDULER, singular, is a deprecated alias.)
PROCELA_DISABLE_SCHEDULERS=

# ── SMTP (transactional email — password resets, "Report a problem") ──
# All five PROD-REQUIRED. When any is missing, /auth/password/forgot and
# /support fall back to writing to the audit log (dev mode) rather than
# delivering to the user / support inbox.
#
# Local dev with `docker compose up`: SMTP is pre-wired to the bundled
# Mailpit catcher — no config needed; read captured mail at
# http://localhost:8025. Running the backend on the host via
# `npm run dev` instead? Start just the catcher with
# `docker compose up mailpit` and uncomment the Mailpit block below.
# Base keys first, then optional example blocks BELOW. dotenv is
# last-value-wins within a file, so uncommenting a whole block cleanly
# overrides these empty defaults. Do NOT re-add SMTP_* lines after a block,
# or the later (empty) line wins and SMTP silently stays off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SMTP_PASS may be plaintext or an enc:v1:… envelope encrypted with
# MFA_ENCRYPTION_KEY. Use POST /auth/encrypt-secret to generate the envelope.
SMTP_PASS=
SMTP_SECURE=false                             # 'true' for port 465 implicit TLS
MAIL_FROM=Procela <noreply@procela.io>
# In-app "Report a problem" inbox. Defaults to support@procela.ai; needs SMTP
# to actually email, else reports are audit-logged only. Keep this value a
# bare address with NO trailing inline comment — it is used verbatim as the
# email recipient.
SUPPORT_EMAIL=support@procela.ai
#
# Uncomment exactly ONE block below to turn SMTP on. (APP_URL is already set
# near the top of this file, so it isn't repeated here.)
#
# ── Local Mailpit catcher (host `npm run dev`) — uncomment to use ──
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=dev
# SMTP_PASS=dev
# SMTP_SECURE=false
# MAIL_FROM=Procela (dev) <noreply@procela.local>
#
# ── Resend (real delivery — https://resend.com) — uncomment to use ──
# Username is the literal string "resend"; the password is your Resend API
# key. MAIL_FROM must be on a domain you've verified in Resend (add its
# SPF/DKIM records on a `send.` subdomain so your root MX/SPF stay with
# your inbox provider). Port 465 = implicit TLS; use 587 + SMTP_SECURE=false
# for STARTTLS if 465 is blocked.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_SECURE=true
# MAIL_FROM=Procela <noreply@procela.ai>

# ── Logging ──
LOG_LEVEL=info

# ── Audit log integrity ──
# The audit log is a hash chain. In production, if entries are found
# without hashes at boot, Procela refuses to auto-bootstrap the chain
# (a missing-hash state is either a legitimate reset or tampering). Set
# to 1 to explicitly allow the bootstrap — e.g. after an intentional
# reset. Default (unset): fail fast in production, auto-bootstrap in dev.
AUDIT_ALLOW_BOOTSTRAP=

# ── CORS allowlist ──
# Comma-separated origins permitted to call the API from a browser.
# APP_URL is automatically included; CORS_ALLOWED_ORIGINS adds more
# (e.g. an admin console at admin.procela.io, a status page, etc.).
# When both are unset, dev fallback echoes the request origin —
# production must set at least one or browsers will block cross-origin
# requests.
CORS_ALLOWED_ORIGINS=

# ── Account lockout (failed sign-ins) ──
# After LOCKOUT_THRESHOLD failed logins for one account within
# LOCKOUT_WINDOW_MS, the account is locked for LOCKOUT_DURATION_MS. This
# gates by account; the CAPTCHA challenge below gates by IP. Defaults:
# 10 attempts / 30-min window / 30-min lock.
LOCKOUT_THRESHOLD=10
LOCKOUT_WINDOW_MS=1800000
LOCKOUT_DURATION_MS=1800000

# ── CAPTCHA (after repeated failed sign-ins) ──
# After CAPTCHA_THRESHOLD failed attempts from one IP within
# CAPTCHA_WINDOW_MS, /auth/login responds with challengeRequired=true
# and demands a captchaToken on subsequent attempts. When
# HCAPTCHA_SITE_KEY + HCAPTCHA_SECRET are set, the frontend renders the
# hCaptcha widget and the backend verifies the token via hCaptcha's
# siteverify endpoint. When unset, the backend accepts any non-empty
# token (dev mode — lets you exercise the flow without an hCaptcha
# account, but offers no real bot protection in production).
CAPTCHA_THRESHOLD=3
CAPTCHA_WINDOW_MS=900000
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# ── Frontend ──
VITE_API_URL=http://localhost:3001/api/v1
# Idle-session timeout in minutes. Default 30; SOC 2 / HIPAA controls
# typically want 15. Frontend auto-logs-out after this many minutes
# of no mouse/keyboard/scroll/touch activity even if the access token
# is still valid.
VITE_IDLE_TIMEOUT_MINUTES=30
