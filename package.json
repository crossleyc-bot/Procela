{
  "name": "procela",
  "version": "0.1.0",
  "private": true,
  "description": "Procela - SaaS platform connecting business processes to data and systems",
  "workspaces": [
    "packages/*"
  ],
  "prisma": {
    "schema": "packages/backend/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "concurrently --names backend,frontend -c blue,green \"npm run dev -w packages/backend\" \"npm run dev -w packages/frontend\"",
    "build": "npm run build -w packages/backend && npm run build -w packages/frontend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:clean": "tsx e2e/clean.ts",
    "loadtest": "tsx loadtest/run.ts",
    "verify:email": "node scripts/verify-resend.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.0",
    "autocannon": "^8.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED"
}
