{
  "name": "@procela/connector",
  "version": "0.3.0",
  "private": true,
  "description": "Procela on-prem connector — runs in customer infrastructure, ships metadata back to Procela over outbound HTTPS.",
  "main": "dist/index.js",
  "bin": {
    "procela-connector": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/__tests__/*.test.ts",
    "test:integration": "tsx --test src/__tests__/adapters.int.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "mssql": "^11.0.1",
    "mysql2": "^3.11.5",
    "oracledb": "^6.10.0",
    "pg": "^8.13.1",
    "undici": "^6.28.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.10.0",
    "@types/oracledb": "^6.10.4",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED"
}
