{
  "name": "@procela/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Procela SaaS platform backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/lib/breached-passwords.txt','dist/lib/breached-passwords.txt');fs.cpSync('src/docs','dist/docs',{recursive:true})\"",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/seed-tidewater.js http://127.0.0.1:3001/api/v1",
    "db:seed:momentum": "node scripts/seed-momentum-governance.js http://127.0.0.1:3001/api/v1",
    "db:migrate-json": "tsx scripts/migrate-json-to-postgres.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "test:live-db": "tsx --test src/__tests__/live-db.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude='src/__tests__/**' --test-coverage-exclude='src/index.ts' --test-coverage-exclude='src/lib/markdown-pdf.ts' src/__tests__/*.test.ts",
    "test:coverage:lcov": "tsx --test --experimental-test-coverage --test-coverage-exclude='src/__tests__/**' --test-coverage-exclude='src/index.ts' --test-coverage-exclude='src/lib/markdown-pdf.ts' --test-reporter=lcov --test-reporter-destination=coverage.lcov --test-reporter=spec --test-reporter-destination=stdout src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1130.0",
    "@azure/storage-blob": "^12.33.0",
    "@dsnp/parquetjs": "^1.8.8",
    "@google-cloud/bigquery": "^9.0.3",
    "@google-cloud/storage": "^8.1.0",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "^6.4.1",
    "@simplewebauthn/server": "^13.3.1",
    "@types/pdfkit": "^0.17.6",
    "argon2": "^0.44.0",
    "avsc": "^5.7.9",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "marked": "^15.0.7",
    "mongodb": "^6.21.0",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.5",
    "nodemailer": "^9.0.3",
    "oracledb": "^6.10.0",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "qrcode": "^1.5.4",
    "redis": "^6.0.0",
    "snowflake-sdk": "^3.3.0",
    "ssh2-sftp-client": "^12.1.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.0",
    "@types/oracledb": "^6.10.4",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "selfsigned": "^5.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "license": "UNLICENSED"
}
