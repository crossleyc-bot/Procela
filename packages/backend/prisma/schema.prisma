// =============================================================================
// Procela Prisma schema
// -----------------------------------------------------------------------------
// Migration target for the JSON-store persistence in
// packages/backend/src/lib/persistence.ts. Field names and enum values match
// the current TypeScript types verbatim so a straightforward
// loadStore -> INSERT migration will work on first pass.
//
// Multi-tenancy: every table carries `orgId` (indexed). Every mutable row
// carries `createdAt` / `updatedAt`. Audit trails cross-reference by id +
// entityType rather than dedicated FKs so any future entity is coverable.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum OrgType {
  COMPANY
  DIVISION
  DEPARTMENT
  TEAM
  UNIT
}

enum StatusMode {
  SIMPLE
  REVIEW
  ADVANCED
}

enum NodeLevel {
  VALUE_STREAM
  DOMAIN
  CAPABILITY
  PROCESS
  SUBPROCESS
  ACTIVITY
  TASK
  EXECUTION
}

enum NodeDomain {
  OPERATIONAL
  GOVERNANCE
}

enum CriticalityTier {
  TIER_1
  TIER_2
  TIER_3
  TIER_4
}

enum GovernanceTier {
  BRONZE
  SILVER
  GOLD
}

enum NotificationType {
  INFO
  WARNING
  ACTION
}

// Governance status / severity / classifier fields are all typed as
// `String` on the entity models below rather than as Prisma enums, so
// customers can extend the vocabulary (add a new task status, a new
// document type, a new group tier) without a schema migration. Same
// pattern DataAsset's classifiers use. The former enums
// (TaskStatus / TaskPriority / IssueSeverity / IssueStatus /
// IssueSource / PolicyType / ControlType / AutomationMode /
// GroupLevel / FlowType / DamaScopeType) were dropped in the
// batch-2 repo migration when the fuller Stored* types landed.

// ─────────────────────────────────────────────────────────────────────────────
// Organization
// Self-referencing tree (Tidewater Utilities -> Tidewater Electric -> Power
// Generation). One row per node; hierarchy is walked via parentId.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id                       String     @id @default(uuid()) @db.Uuid
  parentId                 String?    @db.Uuid
  name                     String
  type                     OrgType    @default(COMPANY)
  industry                 String?
  description              String?    @db.Text
  headCount                Int        @default(0)
  statusMode               StatusMode @default(SIMPLE)
  // Branding fields kept flat rather than under a `branding Json?`
  // blob so tenantSlug can be uniquely indexed for tenant lookup.
  tenantSlug               String?    @unique
  brandDisplayName         String?
  brandGlyph               String?
  ssoButtonLabel           String?
  brandPrimaryColor        String?
  // Active regulatory / export-control classification regimes for this tenant
  // (subset of CUI / ITAR / EXPORT_CONTROLLED). Defaults to all three active
  // (back-compat with the built-in set); an explicit empty [] means none.
  activeSensitivityRegimes String[]   @default(["CUI", "ITAR", "EXPORT_CONTROLLED"])
  // Compliance frameworks selectable as activity compliance tags for this
  // tenant (SOX / HIPAA / GDPR / …). Unlike sensitivity regimes there is no
  // fixed enum — an org admin edits the list, so custom frameworks are allowed.
  // Defaults to the built-in set (back-compat); an explicit empty [] means the
  // tenant has cleared every framework.
  activeComplianceFrameworks String[] @default(["SOX", "HIPAA", "GDPR", "PCI-DSS", "CCPA", "FERPA", "FISMA", "NERC CIP", "ISO 27001", "SOC 2", "NIST", "GLBA", "FERC", "EPA", "OSHA", "ADA", "Other"])
  // Per-tenant Council Scorecard thresholds: { coverage, classification,
  // openIssues, exceptions, openIssuesDays }. Null = use the shipped defaults
  // (80 / 70 / 0 / 0 / 30). Kept as a small JSON blob rather than five columns
  // since it's read/written as one policy object and never queried by field.
  scorecardTargets         Json?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  parent   Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Organization[] @relation("OrgHierarchy")

  personLinks          PersonOrg[]
  processNodes         ProcessNode[]         @relation("ProcessNodeCanonicalOrg")
  processNodeOrgs      ProcessNodeOrg[]
  systems              System[]
  dataDomains          DataDomain[]
  dataAssets           DataAsset[]
  dataAssetBindings    DataAssetBinding[]
  mappings             Mapping[]
  skills               Skill[]
  notifications        Notification[]
  governanceTasks      GovernanceTask[]
  governanceIssues     GovernanceIssue[]
  governancePolicies   GovernancePolicy[]
  governanceControls   GovernanceControl[]
  governanceExceptions GovernanceException[]
  governanceGroups     GovernanceGroup[]
  comments             Comment[]
  // FlowRelationship no longer carries an orgId — see the comment on
  // that model. Its org scope resolves via its fromNode / toNode.

  // Data-sync tracking — soft reference to a SyncConnection (no FK), plus the
  // per-row sync status ('ACTIVE' | 'MISSING_FROM_SOURCE'). Set by the sync
  // engine so a run can update its own prior rows and flag ones dropped from
  // the source. Plain string, not @db.Uuid — a soft reference only compared as text.
  syncConnectionId String?
  syncStatus       String?

  @@index([parentId])
  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Person
// A person can be attached to multiple organisations (many-to-many via
// PersonOrg). Ownership references from other tables point at Person.id.
// ─────────────────────────────────────────────────────────────────────────────

model Person {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  email               String    @unique
  title               String?
  jobRole             String?
  // Default / fallback role when the active org has no per-org override.
  role                String    @default("VIEWER")
  // Per-org role overrides. Stored as JSONB — an array of
  // { orgId, role } tuples the JSON store carries verbatim; a
  // future migration can promote this into a PersonOrgRole join
  // table once the queryability need shows up.
  orgRoles            Json?
  // Auth-heavy fields — see StoredPerson interface in
  // routes/people.ts for authoritative docstrings. In production
  // these should be encrypted at rest (mfaSecret) or hashed
  // (passwordHash, mfaBackupCodes); Prisma's column-level KMS
  // wrapper is the intended solution when it lands.
  passwordHash        String?
  passwordUpdatedAt   DateTime?
  passwordMustChange  Boolean?
  failedLoginCount    Int?
  failedLoginFirstAt  DateTime?
  lockedUntil         DateTime?
  mfaSecret           String?
  mfaEnrolled         Boolean?
  mfaBackupCodes      String[]  @default([])
  // WebAuthn credentials — array of { id, credentialID, publicKey,
  // counter, transports?, label, createdAt }. JSONB keeps the whole
  // shape without a join table since the row is only ever read as
  // a set (not queried by inner fields).
  webauthnCredentials Json?
  // Explicit access grants beyond a person's home orgs. Native
  // Postgres String[] — mirrors the JSON shape one-for-one.
  accessibleOrgIds    String[]  @default([])
  active              Boolean?
  deactivatedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orgLinks            PersonOrg[]
  personSkills        PersonSkill[]
  damaRoles           DamaRole[]
  ownedNodes          ProcessNode[]       @relation("ProcessNodeOwner")
  responsibleForNodes ProcessNode[]       @relation("ProcessNodeResponsible")
  ownedSystems        System[]            @relation("SystemOwner")
  deputySystems       System[]            @relation("SystemDeputyOwner")
  custodianSystems    SystemCustodian[]   @relation("SystemCustodianM2M")
  ownedDomains        DataDomain[]        @relation("DataDomainOwner")
  domainStewards      DataDomainSteward[]
  ownedAssets         DataAsset[]         @relation("DataAssetOwner")
  dataAssetStewards   DataAssetSteward[]  @relation("DataAssetStewardM2M")
  assignedTasks       GovernanceTask[]    @relation("GovernanceTaskAssignee")
  assignedIssues      GovernanceIssue[]   @relation("GovernanceIssueAssignee")

  // Data-sync tracking (soft reference to SyncConnection; see Organization).
  syncConnectionId String?
  syncStatus       String?

  @@map("people")
}

model PersonOrg {
  personId String @db.Uuid
  orgId    String @db.Uuid

  person Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([personId, orgId])
  @@index([orgId])
  @@map("person_orgs")
}

// ─────────────────────────────────────────────────────────────────────────────
// ProcessNode
// Unified table replacing the split VS/Process/SubProcess/Step. Level is an
// enum; hierarchy is a self-referencing parent/child tree. Sequence between
// activities lives in FlowRelationship, not here.
// ─────────────────────────────────────────────────────────────────────────────

model ProcessNode {
  id                  String           @id @default(uuid()) @db.Uuid
  parentId            String?          @db.Uuid
  level               NodeLevel
  name                String
  description         String?          @db.Text
  orgId               String           @db.Uuid
  ownerId             String?          @db.Uuid
  status              String           @default("DRAFT")
  orderIndex          Int              @default(0)
  // Human-readable id (e.g. "VS-0001", "ACT-0042"), NOT a UUID — the app
  // generates these per level. Originally mistyped as @db.Uuid, which made
  // every process-node insert fail on Postgres; corrected to text in the
  // 9b.19 cutover migration.
  activityId          String?
  responsibleRole     String?
  responsiblePersonId String?          @db.Uuid
  // Rich documentation fields — kept nullable text so the UI's
  // "you don't have to fill this in" contract holds and the row
  // migrates cleanly from the JSON store without a forced backfill.
  purpose             String?          @db.Text
  businessOutcome     String?          @db.Text
  stakeholders        String?          @db.Text
  inputsOutputs       String?          @db.Text
  complianceTags      String[]         @default([])
  statusJustification String?          @db.Text
  frequency           String?
  riskLevel           String?
  automationLevel     String?
  estimatedDuration   String?
  criticalityTier     CriticalityTier?
  rtoHours            Int?
  rpoHours            Int?
  successMeasure      String?          @db.Text
  slaTarget           String?
  trigger             String?
  volume              String?
  // Forward-looking governance review date (ISO "YYYY-MM-DD"), distinct from
  // reviewedAt (the last review's timestamp). Free-text date string.
  nextReviewDate      String?
  // Free-text notes on how the activity's risk (riskLevel) is mitigated.
  riskMitigation      String?          @db.Text
  domain              NodeDomain       @default(OPERATIONAL)
  version             Int              @default(1)
  submittedBy         String?          @db.Uuid
  submittedAt         DateTime?
  reviewedBy          String?          @db.Uuid
  reviewedAt          DateTime?
  reviewComment       String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization      Organization  @relation("ProcessNodeCanonicalOrg", fields: [orgId], references: [id], onDelete: Cascade)
  parent            ProcessNode?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children          ProcessNode[] @relation("NodeHierarchy")
  owner             Person?       @relation("ProcessNodeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  responsiblePerson Person?       @relation("ProcessNodeResponsible", fields: [responsiblePersonId], references: [id], onDelete: SetNull)

  orgLinks       ProcessNodeOrg[]
  controls       ProcessNodeControl[]
  requiredSkills ProcessNodeSkill[]
  systems        ProcessNodeSystem[]
  mappings       Mapping[]
  flowsFrom      FlowRelationship[]   @relation("FlowFromNode")
  flowsTo        FlowRelationship[]   @relation("FlowToNode")

  @@index([orgId])
  @@index([orgId, parentId])
  @@index([orgId, level])
  @@map("process_nodes")
}

model ProcessNodeOrg {
  processNodeId String @db.Uuid
  orgId         String @db.Uuid

  processNode ProcessNode  @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([processNodeId, orgId])
  @@index([orgId])
  @@map("process_node_orgs")
}

model ProcessNodeControl {
  processNodeId String @db.Uuid
  controlId     String @db.Uuid

  processNode ProcessNode       @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  control     GovernanceControl @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@id([processNodeId, controlId])
  @@index([controlId])
  @@map("process_node_controls")
}

model ProcessNodeSkill {
  processNodeId String @db.Uuid
  skillId       String @db.Uuid

  processNode ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([processNodeId, skillId])
  @@index([skillId])
  @@map("process_node_skills")
}

model ProcessNodeSystem {
  processNodeId String @db.Uuid
  systemId      String @db.Uuid

  processNode ProcessNode @relation(fields: [processNodeId], references: [id], onDelete: Cascade)
  system      System      @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@id([processNodeId, systemId])
  @@index([systemId])
  @@map("process_node_systems")
}

// ─────────────────────────────────────────────────────────────────────────────
// System
// ─────────────────────────────────────────────────────────────────────────────

model System {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @db.Uuid
  name                String
  description         String?  @db.Text
  systemType          String?
  // String rather than enum so a customer can extend the vocabulary
  // (HIGH/MEDIUM/LOW today) on their side without a schema
  // migration. Same pattern DataAsset's classifiers use.
  businessCriticality String?
  vendor              String?
  // Free-text notes about integration — paired with the structured
  // `integrations` JSONB below. Retained because it captures nuance
  // (informal handshakes, cross-team conventions) that structured
  // rows can't.
  integrationPoints   String?  @db.Text
  // Structured integrations — array of { id, targetSystemId,
  // interfaceType, frequency?, direction }. JSONB keeps the shape
  // without a join-per-integration table; future queryability can
  // promote to a table when the need shows up.
  integrations        Json?
  // INTEGRATED | MANUAL | EXTERNAL. Drives gap-detection so a
  // manual/external system isn't penalised for lacking a Connection.
  connectivity        String?
  // Renamed from `ownerId` → `ownerPersonId` to match the JSON row.
  ownerPersonId       String?  @db.Uuid
  // Deputy owner: same authority when the primary is unavailable,
  // never both at once. Captures coverage / succession without
  // breaking the "one accountable person" property.
  deputyOwnerId       String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        Person?      @relation("SystemOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  deputyOwner  Person?      @relation("SystemDeputyOwner", fields: [deputyOwnerId], references: [id], onDelete: SetNull)

  custodians   SystemCustodian[]
  dataAssets   DataAsset[]
  processNodes ProcessNodeSystem[]

  // Data-sync tracking (soft reference to SyncConnection; see Organization).
  syncConnectionId String?
  syncStatus       String?

  @@index([orgId])
  @@index([orgId, systemType])
  @@map("systems")
}

model SystemCustodian {
  systemId String @db.Uuid
  personId String @db.Uuid

  system System @relation(fields: [systemId], references: [id], onDelete: Cascade)
  person Person @relation("SystemCustodianM2M", fields: [personId], references: [id], onDelete: Cascade)

  @@id([systemId, personId])
  @@index([personId])
  @@map("system_custodians")
}

// ─────────────────────────────────────────────────────────────────────────────
// DataDomain — logical grouping of related data assets under one accountable
// owner. Stewards are M2M so a domain can have several.
// ─────────────────────────────────────────────────────────────────────────────

model DataDomain {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @db.Uuid
  name            String
  description     String?          @db.Text
  ownerId         String?          @db.Uuid
  // Human-readable governance code (e.g. "MFG" / "MFG-02"). Auto-suggested on
  // create, user-editable.
  code            String?
  // Optional parent domain — turns a flat catalog into Domain → Sub-Domain.
  // Nesting is one level deep (enforced in the route layer). onDelete:
  // SetNull re-homes children to top-level if the parent is removed.
  parentDomainId  String?          @db.Uuid
  scopeDefinition String?          @db.Text
  // Business-criticality tier (TIER_1 = council-critical). Drives the Council
  // Scorecard's tier-1 coverage measure; null = unclassified.
  criticality     CriticalityTier?
  status          String           @default("DRAFT")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        Person?      @relation("DataDomainOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parent       DataDomain?  @relation("DataDomainParent", fields: [parentDomainId], references: [id], onDelete: SetNull)
  subDomains   DataDomain[] @relation("DataDomainParent")

  stewards   DataDomainSteward[]
  dataAssets DataAsset[]

  @@index([orgId])
  @@index([parentDomainId])
  @@map("data_domains")
}

model DataDomainSteward {
  dataDomainId String @db.Uuid
  personId     String @db.Uuid

  dataDomain DataDomain @relation(fields: [dataDomainId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([dataDomainId, personId])
  @@index([personId])
  @@map("data_domain_stewards")
}

// ─────────────────────────────────────────────────────────────────────────────
// DataAsset
// ─────────────────────────────────────────────────────────────────────────────

model DataAsset {
  id                      String         @id @default(uuid()) @db.Uuid
  orgId                   String         @db.Uuid
  name                    String
  description             String?        @db.Text
  systemId                String?        @db.Uuid
  // Named ownerPersonId to match the JSON store; the single-owner
  // ownerId slot was superseded by ownerPersonId in the code.
  ownerPersonId           String?        @db.Uuid
  dataDomainId            String?        @db.Uuid
  governanceTier          GovernanceTier @default(BRONZE)
  healthScore             Float          @default(0)
  healthScoreAt           DateTime?
  // True when this asset is the authoritative system-of-record for its data
  // (the golden copy others reconcile to). Default false = a copy / replica
  // or simply undeclared. Powers the "copies with no declared SOR" gap.
  isSystemOfRecord        Boolean        @default(false)
  sensitivityTags         String[]       @default([])
  // String-typed classifiers rather than enums so a customer can
  // extend the taxonomy on their side without a schema migration.
  // The current codebase uses fixed vocabularies but treating them
  // as strings keeps the door open.
  dataType                String?
  refreshFrequency        String?
  origin                  String?
  // Retention policy captured as JSONB — currently { value, unit }
  // in the JSON store, kept structured for future queryability.
  retentionDuration       Json?
  retentionReason         String?        @db.Text
  lastSyncedByConnectorId String?        @db.Uuid
  lastSyncedAt            DateTime?
  // Latest row count reported by an on-prem connector scan (approximate —
  // engine statistics, not a live COUNT(*)). BigInt so billion-row fact
  // tables don't overflow. Null until a connector reports one.
  rowCount                BigInt?
  // Fingerprint (sha256) of the column set reported by the last connector
  // scan. Compared against the next scan's fingerprint to detect schema drift
  // — a column added, removed, or retyped. Null until a scan reports columns.
  schemaFingerprint       String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  system       System?      @relation(fields: [systemId], references: [id], onDelete: SetNull)
  owner        Person?      @relation("DataAssetOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  dataDomain   DataDomain?  @relation(fields: [dataDomainId], references: [id], onDelete: SetNull)

  stewards DataAssetSteward[]
  bindings DataAssetBinding[]
  mappings Mapping[]

  @@index([orgId])
  @@index([orgId, systemId])
  @@index([orgId, dataDomainId])
  @@index([orgId, governanceTier])
  @@map("data_assets")
}

model DataAssetSteward {
  dataAssetId String @db.Uuid
  personId    String @db.Uuid

  dataAsset DataAsset @relation(fields: [dataAssetId], references: [id], onDelete: Cascade)
  person    Person    @relation("DataAssetStewardM2M", fields: [personId], references: [id], onDelete: Cascade)

  @@id([dataAssetId, personId])
  @@index([personId])
  @@map("data_asset_stewards")
}

// ─────────────────────────────────────────────────────────────────────────────
// DataAssetBinding — physical source(s) an asset resolves to via a connection
// profile. One asset can have many (dev/staging/prod, primary/failover).
// ─────────────────────────────────────────────────────────────────────────────

model DataAssetBinding {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  dataAssetId   String   @db.Uuid
  connectionId  String   @db.Uuid
  sourceAsset   String
  // sourceColumn is the legacy single column (mirrors sourceColumns[0]);
  // sourceColumns is the named column set the asset binds to (empty = whole asset).
  sourceColumn  String?
  sourceColumns String[] @default([])
  // Optional free-form label ("prod", "staging", …) and a primary flag
  // (exactly one binding per asset should be primary once any exist).
  // Both fields carried on the JSON row already; the schema drift here
  // was picked up during the secondary-store repo sweep.
  label         String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dataAsset    DataAsset    @relation(fields: [dataAssetId], references: [id], onDelete: Cascade)
  // connectionId is intentionally an unresolved reference — the Connection
  // model lives in the secondary-store batch and will be added when those
  // land. Cascade rules on delete are handled application-side today.

  @@index([orgId])
  @@index([orgId, dataAssetId])
  @@index([connectionId])
  @@map("data_asset_bindings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Mapping (process step ↔ data asset)
// ─────────────────────────────────────────────────────────────────────────────

model Mapping {
  id                 String   @id @default(uuid()) @db.Uuid
  orgId              String   @db.Uuid
  processStepId      String   @db.Uuid
  // One of dataAssetId / policyId / attachmentId is set; the mapping
  // is the tri-target join between a process step and any of these
  // three artefacts. Attachment isn't modelled in the schema yet, so
  // attachmentId is a plain uuid with no FK — cascade rules on
  // attachment delete are handled application-side today.
  dataAssetId        String?  @db.Uuid
  policyId           String?  @db.Uuid
  attachmentId       String?  @db.Uuid
  linkType           String?
  notes              String?  @db.Text
  aiSuggested        Boolean  @default(false)
  userOverridden     Boolean  @default(false)
  criticality        String? // REQUIRED | OPTIONAL (String so vocab can extend)
  dataFormat         String?
  sla                String?
  qualityRequirement String?  @db.Text
  fulfillsExpected   String?
  createdBy          String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  processStep  ProcessNode       @relation(fields: [processStepId], references: [id], onDelete: Cascade)
  dataAsset    DataAsset?        @relation(fields: [dataAssetId], references: [id], onDelete: Cascade)
  policy       GovernancePolicy? @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, processStepId])
  @@index([orgId, dataAssetId])
  @@index([orgId, policyId])
  @@map("mappings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Skill + PersonSkill
// ─────────────────────────────────────────────────────────────────────────────

model Skill {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  name        String
  description String?  @db.Text
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  personSkills PersonSkill[]
  processNodes ProcessNodeSkill[]

  @@index([orgId])
  @@index([orgId, category])
  @@map("skills")
}

model PersonSkill {
  id       String @id @default(uuid()) @db.Uuid
  personId String @db.Uuid
  skillId  String @db.Uuid

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([personId, skillId])
  @@index([skillId])
  @@map("person_skills")
}

// ─────────────────────────────────────────────────────────────────────────────
// DAMA roles — a person holds a DAMA-aligned role scoped to an org, domain,
// system, or asset. scopeType decides which entity scopeId resolves to.
// ─────────────────────────────────────────────────────────────────────────────

model DamaRole {
  id        String   @id @default(uuid()) @db.Uuid
  // Exactly one of (personId, agentId) is set per row. Both nullable
  // so a person-only or agent-only role assignment can be created; the
  // route validator enforces exclusivity.
  personId  String?  @db.Uuid
  agentId   String?  @db.Uuid
  // Snapshot of the agent name at assignment time — kept so a later
  // rename / deletion of the agent doesn't wipe the historical label
  // off the assignment ledger.
  agentName String?
  roleType  String
  // String rather than a Prisma enum — the JSON store today only uses
  // ORG / DOMAIN but is expected to grow (SYSTEM / ASSET are the
  // planned next tiers). Same vocabulary-extension pattern.
  scopeType String
  scopeId   String   @db.Uuid
  since     String
  createdAt DateTime @default(now())

  person Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([scopeType, scopeId])
  @@map("dama_roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// AuditLog — append-only hash-chained record of every write.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  // orgId is String (not Uuid) because the hash-chain bootstrap
  // marker uses the sentinel value "system" — an audit log is a
  // ledger, not a scoped resource, and the bootstrap boundary
  // marker isn't owned by any real org. That also breaks the FK
  // to Organization: model the relation as optional and let the
  // application enforce the sentinel isn't used elsewhere.
  orgId      String
  userId     String?
  entityType String
  // entityId is arbitrary — the auditService.log() surface accepts
  // any string. It's a UUID for most rows (Person id, Asset id,
  // …) but also carries values like "chain", "password", "migrate",
  // or "*" (bulk-delete markers).
  entityId   String
  action     String
  before     Json?
  after      Json?
  timestamp  DateTime @default(now())
  prevHash   String?
  entryHash  String?

  @@index([orgId])
  @@index([orgId, entityType, entityId])
  @@index([orgId, timestamp])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  orgId     String           @db.Uuid
  userId    String?          @db.Uuid
  type      NotificationType @default(INFO)
