// `derived` is the machine-computed snapshot (per-division rows + enterprise
// rollup); `overrides` is a sparse map of CDO/DGL edits layered on top;
// `narrative` holds the two prose sections. Matches the MaturitySnapshot
// pattern (no FK relation — orgId + index).
model CouncilScorecard {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  period    String
  status    String   @default("PUBLISHED")
  createdBy String?
  derived   Json     @default("{}")
  overrides Json     @default("{}")
  narrative Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("council_scorecards")
}

model GapSnapshot {
  id      String @id @default(uuid()) @db.Uuid
  orgId   String @db.Uuid
  takenAt String
  metrics Json   @default("{}")

  @@index([orgId])
  @@map("gap_snapshots")
}

model StatsSnapshot {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @db.Uuid
  capturedAt String
  coverage   Float
  avgHealth  Float
  gaps       Int
  dataAssets Int
  mappings   Int

  @@index([orgId])
  @@map("stats_snapshots")
}

model ProcessVersion {
  id        String   @id @default(uuid()) @db.Uuid
  nodeId    String   @db.Uuid
  version   Int
  snapshot  Json     @default("{}")
  changedBy String?
  changedAt DateTime
  status    String   @default("")
  note      String   @default("") @db.Text

  @@index([nodeId])
  @@map("process_versions")
}

model Agent {
  id            String   @id @default(uuid()) @db.Uuid
  orgIds        String[] @default([])
  name          String
  agentType     String   @default("AI")
  description   String   @default("") @db.Text
  provider      String   @default("")
  status        String   @default("ACTIVE")
  ownerPersonId String?
  skillIds      String[] @default([])
  instructions  String   @default("") @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerPersonId])
  @@map("agents")
}

model AgentSchedule {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  agentId      String   @db.Uuid
  agentName    String
  activityId   String   @db.Uuid
  activityName String
  roleType     String
  frequency    String
  status       String   @default("ACTIVE")
  startAt      String
  nextRunAt    String
  lastRunAt    String?
  runCount     Int      @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@index([agentId])
  @@map("agent_schedules")
}

model AgentExecution {
  id                 String   @id @default(uuid()) @db.Uuid
  orgId              String   @db.Uuid
  agentId            String   @db.Uuid
  agentName          String
  activityId         String   @db.Uuid
  activityName       String
  roleType           String
  status             String   @default("PENDING")
  startedAt          String
  completedAt        String?
  output             String   @default("") @db.Text
  error              String?  @db.Text
  durationMs         Int?
  reviewStatus       String   @default("PENDING")
  reviewedBy         String?
  reviewedAt         String?
  promotedDocumentId String?
  createdAt          DateTime @default(now())

  @@index([orgId])
  @@index([agentId])
  @@map("agent_executions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Postgres cutover (PR 1) — stores that previously had no Prisma model.
// See docs/POSTGRES_CUTOVER_PLAN.md. These are the JSON stores that don't fit
// the standard {id} entity-repository pattern: global singletons collapse into
// AppSetting; the dbt / RACI mappings use composite primary keys.
// aiTemplateCache is intentionally NOT modeled — it is a regenerable AI cache
// and stays in-memory per instance in Postgres mode.
// ─────────────────────────────────────────────────────────────────────────────

// Generic global key-value config. Backs the former `branding`, `aiSettings`,
// and `schedulerState` single-row JSON stores. `value` holds the store's row
// object verbatim, so each consumer keeps its own typed shape.
model AppSetting {
  key       String   @id
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_settings")
}

// SCIM 2.0 group (IdP-provisioned). Members are stored as a JSON array to match
// the StoredScimGroup shape; there is no orgId — SCIM groups are
// directory-global, mirroring the current store.
model ScimGroup {
  id          String   @id @db.Uuid
  displayName String
  externalId  String?
  members     Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("scim_groups")
}

// Manual RACI cell override keyed by (processNode, person). No orgId in the
// current store; scope is implied by the node. Kept FK-free so an override can
// outlive a transiently-missing node/person row, matching the JSON behavior.
model RaciOverride {
  nodeId   String
  personId String
  value    String
  reason   String?

  @@id([nodeId, personId])
  @@map("raci_overrides")
}

// Maps a dbt manifest node to a Procela data asset so re-imports reuse the same
// asset. Composite key (orgId, dbtUniqueId).
model DbtAssetMapping {
  orgId       String
  dbtUniqueId String
  assetId     String

  @@id([orgId, dbtUniqueId])
  @@index([orgId])
  @@map("dbt_asset_mappings")
}

// Maps a dbt test node to a Procela data-quality rule so re-imports reuse the
// same rule. Composite key (orgId, dbtUniqueId).
model DbtTestMapping {
  orgId       String
  dbtUniqueId String
  ruleId      String

  @@id([orgId, dbtUniqueId])
  @@index([orgId])
  @@map("dbt_test_mappings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Postgres cutover (PR 2) — auth persistence foundation.
// See docs/POSTGRES_CUTOVER_PLAN.md. Backs auth state that is currently
// in-memory-only (no store, no model). The global `authConfig` singleton reuses
// the AppSetting key-value table (key "authConfig") and needs no model here.
// ─────────────────────────────────────────────────────────────────────────────

// Refresh-token / session store. Replaces the in-memory validRefreshTokens Map
// in routes/auth.ts so sessions survive a restart and are shared across
// instances. Keyed by the token's jti. Timestamps are ISO strings to match the
// in-memory RefreshTokenContext shape verbatim (same convention as
// AgentExecution.startedAt).
model RefreshToken {
  jti              String  @id
  personId         String?
  oidcProviderId   String?
  oidcIdToken      String? @db.Text
  samlNameID       String?
  samlSessionIndex String?
  ip               String?
  userAgent        String? @db.Text
  createdAt        String?
  lastUsedAt       String?

  @@index([personId])
  @@map("refresh_tokens")
}

// OIDC provider registry (multi-IdP). Replaces the in-memory oidcProviders Map.
// `clientSecret` is sensitive — encrypt at rest via KMS before production
// (go-live checklist #11); stored as-is here to match the current in-memory
// handling. allowedEmailDomains is a scalar list (empty = no domain scoping).
model OidcProvider {
  id                  String   @id
  displayName         String
  issuer              String
  clientId            String
  clientSecret        String
  allowedEmailDomains String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("oidc_providers")
}

// Scheduler leader election. A single row ("scheduler") holds the current
// owner of the background timer work (overdue sweep, weekly digest, agent
// runs, DQ + dbt polling). One process claims the lease via an atomic
// conditional upsert and renews it on a heartbeat; if it dies the lease
// expires and another replica takes over. Ensures shared/costly timers run
// once across a horizontally-scaled deployment. See lib/scheduler-leadership.ts.
model SchedulerLease {
  id        String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@map("scheduler_leases")
}
